namespace harness {
    void register_tool_provider(ToolProvider provider);
    void update_mcp_tools(sequence<McpTool> tools);
    void unregister_tool_provider();
    void register_a2a_provider(A2aProvider provider);
    void unregister_a2a_provider();
    void register_model_serve_callback(ModelServeCallback provider);
    void unregister_model_serve_callback();
    void register_agent_event_sink(AgentEventSink sink);
    void unregister_agent_event_sink();
    void configure_context_directories(string agents_directory, string persona_directory);
    void clear_context_directories();
    void cancel_agent_loop();
    AppResult app_open_store(string database_path);
    AppResult app_start_session();
    AppResult app_resume_session(i64 session_id);
    AppResult app_send_message(string user_input);
    AppResult app_list_sessions();
    AppResult app_load_session(i64 session_id);
    AppResult app_delete_session(i64 session_id);
    AppResult app_put_proactive_rule(string scenario, boolean enabled, i64 local_minute,
        i64 weekday_mask, i64 lead_minutes, i64 timezone_offset_minutes);
    AppResult app_put_proactive_task(string task_json);
    AppResult app_delete_proactive_task(string id);
    AppResult app_get_proactive_settings();
    AppResult app_set_proactive_settings(boolean enabled, i64 discovery_interval_minutes);
    void register_memory_sync_wake(MemorySyncWake sink);
    void unregister_memory_sync_wake();
    AppResult app_prepare_memory_sync();
    AppResult app_acknowledge_memory_sync(i64 generation);
    AppResult app_memory_sync_pending();
    AppResult app_export_memory_sync();
    AppResult app_merge_memory_sync(string records_json);
    AppResult app_process_pending_proactive_plans(i64 timezone_offset_minutes);
    AppResult app_discover_proactive_tasks(i64 timezone_offset_minutes);
    AppResult app_list_proactive_rules();
    AppResult app_next_proactive_wake_at();
    AppResult app_rebase_proactive_rules(i64 timezone_offset_minutes);
    AppResult app_run_due_proactive();
    AppResult app_ready_proactive_notifications();
    AppResult app_mark_proactive_delivered(i64 id);
    AppResult app_a2a_put_agent(string agent_json);
    AppResult app_a2a_delete_agent(string agent_id);
    AppResult app_a2a_list_agents();
    AppResult app_a2a_put_task(string task_json);
    AppResult app_a2a_list_tasks();
};

[Error]
enum ToolExecutionError {
    "Timeout",
    "PermissionDenied",
    "NetworkUnreachable",
    "InvalidArguments",
    "ResourceNotFound",
    "ServerInternalError",
    "Cancelled",
    "Unknown"
};

[Error]
enum ModelServeError {
    "RequestFailed",
    "Cancelled",
    "Unknown"
};

typedef record McpTool;
typedef record ToolListReply;
typedef record ToolCallReply;
typedef record AppResult;
typedef trait_with_foreign ToolProvider;
typedef trait_with_foreign A2aProvider;
typedef trait_with_foreign ModelServeCallback;
typedef trait_with_foreign ModelStreamCallback;
typedef trait_with_foreign AgentEventSink;

typedef trait_with_foreign MemorySyncWake;
